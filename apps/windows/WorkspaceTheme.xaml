<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="WorkspaceInk" Color="#243033"/>
  <SolidColorBrush x:Key="WorkspaceMuted" Color="#546166"/>
  <SolidColorBrush x:Key="WorkspacePanel" Color="#F8F9F8"/>
  <SolidColorBrush x:Key="WorkspaceBar" Color="#F1F3F2"/>
  <SolidColorBrush x:Key="WorkspaceCanvas" Color="#E4E8E7"/>
  <SolidColorBrush x:Key="WorkspaceLine" Color="#D1D8D6"/>
  <SolidColorBrush x:Key="WorkspaceAccent" Color="#246B6B"/>
  <SolidColorBrush x:Key="WorkspaceSelection" Color="#D8EBE8"/>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource WorkspaceMuted}"/>
  </Style>
  <Style TargetType="Button">
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="MinHeight" Value="27"/>
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="{StaticResource WorkspaceInk}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Surface" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource WorkspaceSelection}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#C5DFDB"/></Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions><Condition Property="Tag" Value="primary"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
              <Setter TargetName="Surface" Property="Background" Value="#1B5757"/>
            </MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource WorkspaceAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.53"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Margin" Value="1,0"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Padding" Value="3"/>
  </Style>
  <Style x:Key="WorkspaceInput" TargetType="TextBox">
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="MinHeight" Value="29"/>
    <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLine}"/>
    <Setter Property="Foreground" Value="{StaticResource WorkspaceInk}"/>
  </Style>
  <Style x:Key="WorkspaceRow" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Margin" Value="0,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Background" CornerRadius="5" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Background" Property="Background" Value="#EBEFEE"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Background" Property="Background" Value="{StaticResource WorkspaceSelection}"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Background" Property="BorderBrush" Value="{StaticResource WorkspaceAccent}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="{StaticResource WorkspaceLine}"/>
    <Setter Property="ShowsPreview" Value="True"/>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="Foreground" Value="{StaticResource WorkspaceMuted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#EBEFEE"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{StaticResource WorkspaceSelection}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="TabSurface" Property="BorderBrush" Value="{StaticResource WorkspaceAccent}"/>
              <Setter Property="Foreground" Value="{StaticResource WorkspaceInk}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
