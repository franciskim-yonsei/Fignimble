<Window x:Class="Fignimble.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Fignimble.Windows"
        Title="Fignimble for Windows" Width="1120" Height="760" MinWidth="680" MinHeight="450"
        PreviewKeyDown="HandleKey">
  <DockPanel>
    <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
      <ToolBar Band="0" BandIndex="0">
        <Button x:Name="NewProjectButton" Click="NewProjectClicked" Padding="8,4">_New project…</Button>
        <Button x:Name="OpenButton" Click="OpenClicked" Padding="8,4">_Open project…</Button>
        <Separator />
        <Label Target="{Binding ElementName=Figures}" Content="_Figure:" />
        <ComboBox x:Name="Figures" Width="130" SelectionChanged="FigureChanged" AutomationProperties.Name="Figure" />
        <Button x:Name="NewFigureButton" Click="NewFigureClicked" Padding="8,4">New figure…</Button>
        <Button x:Name="ReloadButton" Click="ReloadClicked" Padding="8,4">Reload</Button>
      </ToolBar>
      <ToolBar Band="1" BandIndex="0">
        <Button x:Name="ImportButton" Click="ImportClicked" Padding="8,4" ToolTip="Add a Python panel, image, or table">_Import…</Button>
        <Button x:Name="SampleButton" Click="SampleClicked" Padding="8,4" ToolTip="Insert a self-contained matplotlib example">Add _sample plot</Button>
        <Button x:Name="AnnotationButton" Click="AnnotationClicked" Padding="8,4">Annotate…</Button>
        <Button x:Name="ArrangeButton" Click="ArrangeClicked" Padding="8,4">Arrange ▾</Button>
        <Separator />
        <Button x:Name="UndoButton" Click="UndoClicked" Padding="8,4" ToolTip="Ctrl+Z">_Undo</Button>
        <Button x:Name="RedoButton" Click="RedoClicked" Padding="8,4" ToolTip="Ctrl+Y">_Redo</Button>
        <Button x:Name="ExportButton" Click="ExportClicked" Padding="8,4">_Export…</Button>
      </ToolBar>
    </ToolBarTray>
    <Border DockPanel.Dock="Bottom" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="8,4">
      <TextBlock x:Name="Status" TextWrapping="Wrap" AutomationProperties.Name="Status" />
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="175" MinWidth="120" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="*" MinWidth="170" />
        <ColumnDefinition Width="5" />
        <ColumnDefinition Width="340" MinWidth="190" />
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0" Margin="6">
        <TextBlock DockPanel.Dock="Top" Text="Layers · front to back" FontWeight="SemiBold" Margin="0,2,0,5" />
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
          <Button x:Name="FrontButton" Click="LayerButtonClicked" Tag="front" Content="Front" Padding="4,2" />
          <Button x:Name="ForwardButton" Click="LayerButtonClicked" Tag="forward" Content="Up" Padding="4,2" />
          <Button x:Name="BackwardButton" Click="LayerButtonClicked" Tag="backward" Content="Down" Padding="4,2" />
          <Button x:Name="BackButton" Click="LayerButtonClicked" Tag="back" Content="Back" Padding="4,2" />
          <Button x:Name="VisibilityButton" Click="VisibilityClicked" Content="Hide" Padding="4,2" />
          <Button x:Name="LockButton" Click="LockClicked" Content="Lock" Padding="4,2" />
        </WrapPanel>
        <ListBox x:Name="Layers" SelectionMode="Extended" SelectionChanged="LayersChanged"
                 MouseDoubleClick="LayersDoubleClicked" DisplayMemberPath="Title" AutomationProperties.Name="Layers"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
      </DockPanel>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#D0D0D0" />
      <DockPanel Grid.Column="2" Background="#E6E8EC">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="4">
          <Button Click="ZoomClicked" Tag="out" Content="−" Width="30" AutomationProperties.Name="Zoom out" />
          <Button Click="ZoomClicked" Tag="fit" Content="Fit" Width="40" />
          <Button Click="ZoomClicked" Tag="in" Content="+" Width="30" AutomationProperties.Name="Zoom in" />
          <TextBlock x:Name="ZoomText" Margin="8,2,0,0" Text="Fit" />
        </StackPanel>
        <Grid ClipToBounds="True">
          <TextBlock x:Name="EmptyCanvas" Text="Open a folder containing a Fignimble figure (.py)."
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
          <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                        SizeChanged="ViewportResized" PreviewMouseWheel="ViewportWheel" PanningMode="Both"
                        PreviewMouseDown="PanStarted" PreviewMouseUp="PanEnded" PreviewMouseMove="PanMoved"
                        LostMouseCapture="PanLost">
            <Viewbox x:Name="PageView" Margin="14" Visibility="Collapsed">
              <local:FigureCanvas x:Name="Page" AutomationProperties.Name="Figure canvas" />
            </Viewbox>
          </ScrollViewer>
        </Grid>
      </DockPanel>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="#D0D0D0" />
      <DockPanel Grid.Column="4">
        <GroupBox x:Name="Geometry" DockPanel.Dock="Top" Header="Page geometry (mm)" Margin="8,6,8,4">
          <StackPanel Margin="6">
            <UniformGrid Columns="2">
              <StackPanel x:Name="XField" Margin="3">
                <Label Target="{Binding ElementName=XInput}" Content="X" Padding="0,0,0,3" />
                <TextBox x:Name="XInput" AutomationProperties.Name="X in millimeters" />
              </StackPanel>
              <StackPanel x:Name="YField" Margin="3">
                <Label Target="{Binding ElementName=YInput}" Content="Y" Padding="0,0,0,3" />
                <TextBox x:Name="YInput" AutomationProperties.Name="Y in millimeters" />
              </StackPanel>
              <StackPanel Margin="3">
                <Label Target="{Binding ElementName=WidthInput}" Content="Width" Padding="0,0,0,3" />
                <TextBox x:Name="WidthInput" AutomationProperties.Name="Width in millimeters" />
              </StackPanel>
              <StackPanel Margin="3">
                <Label Target="{Binding ElementName=HeightInput}" Content="Height" Padding="0,0,0,3" />
                <TextBox x:Name="HeightInput" AutomationProperties.Name="Height in millimeters" />
              </StackPanel>
            </UniformGrid>
            <WrapPanel Margin="3,6,3,2">
              <Button x:Name="ApplyButton" Click="ApplyGeometryClicked" Content="Apply" Padding="8,3" />
              <Button x:Name="FitButton" Click="FitClicked" Content="Fit page to content" Padding="8,3" Margin="6,0,0,0" />
              <Button x:Name="PresetButton" Click="PresetClicked" Content="Journal width…" Padding="8,3" Margin="6,0,0,0" />
              <Button x:Name="DetailsButton" Click="DetailsClicked" Content="Edit…" Padding="8,3" Margin="6,0,0,0" />
              <Button x:Name="RemoveButton" Click="RemoveClicked" Content="Remove" Padding="8,3" Margin="6,0,0,0" />
            </WrapPanel>
          </StackPanel>
        </GroupBox>
        <Expander x:Name="Checks" DockPanel.Dock="Top" Header="Preflight" Margin="8,3">
          <ListBox x:Name="Warnings" MaxHeight="115" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Preflight messages">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Expander>
        <TextBlock x:Name="SourceTitle" DockPanel.Dock="Top" Padding="8" FontWeight="SemiBold" Text="Figure source" />
        <TextBox x:Name="SourceText" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="13"
                 BorderThickness="0" Padding="8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="Figure source" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
