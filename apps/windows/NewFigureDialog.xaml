<Window x:Class="Fignimble.Windows.NewFigureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New figure" Width="340" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="16">
    <Label Content="_Name" Target="{Binding ElementName=InputName}" Padding="0,0,0,4" />
    <TextBox x:Name="InputName" Text="fig" />
    <UniformGrid Columns="2" Margin="0,10,0,6">
      <StackPanel Margin="0,0,5,0">
        <Label Content="_Width (mm)" Target="{Binding ElementName=InputWidth}" Padding="0,0,0,4" />
        <TextBox x:Name="InputWidth" />
      </StackPanel>
      <StackPanel Margin="5,0,0,0">
        <Label Content="_Height (mm)" Target="{Binding ElementName=InputHeight}" Padding="0,0,0,4" />
        <TextBox x:Name="InputHeight" />
      </StackPanel>
    </UniformGrid>
    <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="Create" IsDefault="True" MinWidth="72" Padding="8,4" Click="CreateClicked" />
      <Button Content="Cancel" IsCancel="True" MinWidth="72" Padding="8,4" Margin="6,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
